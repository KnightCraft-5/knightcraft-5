		{
			dependencies: ["2000000000000A31"]
			description: [
				"Bu sunucuda can, hayatta kalmanın kendisidir."
				""
				"§bNeden:§r Ignis gibi patronlar azami canının yüzdesi kadar vurur -"
				"ama sabit hasar da alırsın. Havuzun ne kadar büyükse o kadar çok"
				"hata payın olur. Kalp kristali azami canını kalıcı olarak arttırır."
				""
				"§eTarif:§r Ametist + altın + nether yıldızı parçaları. Ametist mağaraları"
				"Y=0 civarında geode olarak bulunur."
				""
				"§7Health IS survival here. Bosses like Ignis hit for a percentage of your"
				"§7max, but you take flat damage too - a bigger pool means more mistakes"
				"§7survived. Heart crystals raise your maximum permanently.§r"
			]
			icon: "bhc:soul_heart_crystal"
			id: "2000000000000B33"
			optional: true
			rewards: [{
				id: "4000000000000E32"
