				item: "ars_nouveau:glyph_break"
				type: "item"
			}]
			title: "Kırma Büyüsü"
			x: 9.0d
			y: 0.88d
		}
		{
			dependencies: [
				"2000000000000F04"
				"2000000000000F05"
			]
			dependency_requirement: "one_completed"
			description: [
				"Büyü bedava değildir. Kaynak ister."
				""
				"§bNe yapar:§r Kaynak (Source), Ars Nouveau'nun manasıdır."
				"Kitabın kendi kaynağını yavaşça doldurur, ama büyük büyüler"
				"için altyapı kurman gerekir."
				""
				"§eNasıl yapılır:§r Imbuement Chamber ile lapis lazuli'den"
				"dönüştürülür. Bu paketteki ilk büyü makinesi budur."
				""
				"§7Magic is not free - it costs Source, Ars Nouveau's mana."
				"§7Your book refills slowly on its own, but big spells need"
				"§7infrastructure. Source Gems are made in the Imbuement Chamber.§r"
			]
			icon: "ars_nouveau:source_gem"
			id: "2000000000000F06"
			rewards: [{
				id: "4000000000000F06"
				type: "xp"
				xp: 180
			}]
			subtitle: "Source Gem"
			tasks: [{
				count: 8L
				id: "3000000000000F06"
