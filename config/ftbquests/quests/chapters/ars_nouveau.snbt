		{
			dependencies: [
				"2000000000000F07"
				"2000000000000F08"
			]
			dependency_requirement: "one_completed"
			description: [
				"Aynı büyü, farklı sonuç."
				""
				"§bGüçlendir (Amplify)§r etkinin gücünü arttırır - daha çok hasar,"
				"daha yüksek hasat seviyesi."
				"§bAlan (AOE)§r etkiyi geniş bir alana yayar."
				"§bDelip Geç (Pierce)§r merminin durmasını engeller."
				"§bHızlandır§r merminin hızını arttırır."
				""
				"§eÖrnek:§r Mermi + Zarar + Güçlendir + Güçlendir = tek hedefe"
				"çok ağır hasar. Mermi + Zarar + Alan = kalabalığa karşı."
				""
				"§7The same spell, a different outcome. Amplify raises power, AOE"
				"§7spreads it, Pierce stops the projectile being stopped."
				"§7Projectile + Harm + Amplify + Amplify hits one target hard;"
				"§7Projectile + Harm + AOE clears a crowd.§r"
			]
			icon: "ars_nouveau:glyph_amplify"
			id: "2000000000000F10"
			rewards: [{
				id: "4000000000000F10"
				type: "xp_levels"
				xp_levels: 20
			}]
			shape: "square"
			subtitle: "Augment Glyphs"
			tasks: [
				{
