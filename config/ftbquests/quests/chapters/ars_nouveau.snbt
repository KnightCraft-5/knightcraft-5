	quest_links: [ ]
	quests: [
		{
			dependencies: ["2000000000000A31"]
			description: [
				"Kılıç tek yol değil."
				""
				"§bNeden:§r Ars Nouveau bu paketteki ikinci güç sistemi. Kendi"
				"büyülerini yazarsın - iyileştirme, ışınlanma, alan hasarı."
				"Zindan baskınlarında bir büyücü grubun hayatta kalmasını sağlar."
				""
				"§eStrateji:§r Kitabı yap, sonra Imbuement Chamber kur. Ametist"
				"odakları da burada işe yarar."
				""
				"§7The sword is not the only path. Ars Nouveau is the pack's second power"
				"§7system - you write your own spells: healing, blink, area damage."
				"§7On a dungeon raid, a mage keeps the group alive.§r"
			]
			icon: "ars_nouveau:novice_spell_book"
			id: "2000000000000B34"
			rewards: [{
				id: "4000000000000E33"
				type: "xp"
				xp: 140
			}]
			shape: "square"
			subtitle: "The Apprentice Mage"
			tasks: [{
				id: "3000000000000B35"
				item: "ars_nouveau:novice_spell_book"
				type: "item"
			}]
			title: "Çırak Büyücü"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["2000000000000B34"]
			description: [
				"Kitap büyüyü taşır ama yazmaz. Yazmak için masa gerekir."
				""
				"§bNe yapar:§r Kitabı masaya koy, sağ tıkla, glifleri sırayla"
				"diz. Biçim önce, etkiler sonra. Kaydet ve kitabın o büyüyü"
				"öğrenmiş olur."
				""
				"§eİpucu:§r Kitapta birden fazla büyü yuvası var. Farklı"
				"durumlar için farklı büyüler hazırla - biri saldırı, biri"
				"kazma, biri kaçış."
				""
				"§7The book carries spells but cannot write them. Place the book on"
				"§7the table, right-click, and lay out glyphs in order: form first,"
				"§7then effects. The book has several slots - prepare one for attack,"
				"§7one for mining, one for escape.§r"
			]
			icon: "ars_nouveau:scribes_table"
			id: "2000000000000F02"
			rewards: [{
				id: "4000000000000F02"
				type: "xp"
				xp: 120
			}]
			subtitle: "The Scribe's Table"
			tasks: [{
				id: "3000000000000F02"
				item: "ars_nouveau:scribes_table"
				type: "item"
			}]
			title: "Yazıcının Masası"
			x: 3.0d
			y: 0.0d
		}
		{
			dependencies: ["2000000000000F02"]
			description: [
				"Biçim olmadan büyü olmaz. Mermi en temel biçimdir."
				""
				"§bNe yapar:§r Büyüyü bir ok gibi ileri fırlatır. Neye çarparsa"
				"etkiler orada çözülür."
				""
				"§eDiğer biçimler:§r Dokunuş (yakın menzil), Kendine (kendi"
				"üzerinde), Ayak Altı (durduğun yer), Yörünge (etrafında döner),"
				"Duvar, Rün (yere kurulan tuzak)."
				""
				"§7No form, no spell. Projectile throws the spell forward like an"
				"§7arrow - whatever it hits, the effects resolve there."
				"§7Other forms: Touch, Self, Underfoot, Orbit, Wall, Rune.§r"
			]
			icon: "ars_nouveau:glyph_projectile"
			id: "2000000000000F03"
			rewards: [{
				id: "4000000000000F03"
				type: "xp"
				xp: 150
			}]
			shape: "square"
			subtitle: "First Form: Projectile"
			tasks: [{
				id: "3000000000000F03"
				item: "ars_nouveau:glyph_projectile"
				type: "item"
			}]
			title: "İlk Biçim: Mermi"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["2000000000000F03"]
			description: [
				"Biçim nereye gittiğini söyler. Etki ne olduğunu."
				""
				"§bMermi + Zarar§r = bu paketteki ilk gerçek büyün."
				"Kılıç menzilinin dışından hasar vermeni sağlar."
				""
				"§eStrateji:§r Ignis gibi patronlarda menzil hayattır. Bir büyücü"
				"uzaktan vurur, yakın dövüşçüler öne çıkar."
				""
				"§7The form says where, the effect says what."
				"§7Projectile + Harm is your first real spell - damage from outside"
				"§7sword range. On bosses like Ignis, range is life.§r"
			]
			icon: "ars_nouveau:glyph_harm"
			id: "2000000000000F04"
			rewards: [{
				id: "4000000000000F04"
				type: "xp"
				xp: 150
			}]
			shape: "square"
			subtitle: "First Effect: Harm"
			tasks: [{
				id: "3000000000000F04"
				item: "ars_nouveau:glyph_harm"
				type: "item"
			}]
			title: "İlk Etki: Zarar"
			x: 9.0d
			y: -0.88d
		}
		{
			dependencies: ["2000000000000F03"]
			description: [
				"Kazma yorulur. Büyü yorulmaz."
				""
				"§bDokunuş + Kır§r = kazmasız madencilik."
				"§bMermi + Kır + Alan§r = uzaktan koca bir delik."
				""
				"§eÖnemli:§r Güçlendir glifi Kır'ın hasat seviyesini yükseltir -"
				"yani elmas ve obsidyeni de kırabilir hale gelir."
				""
				"§7A pickaxe tires. A spell does not. Touch + Break is mining"
				"§7without a pickaxe. Amplify raises Break's harvest level, so it"
				"§7will cut diamond and obsidian.§r"
			]
			icon: "ars_nouveau:glyph_break"
			id: "2000000000000F05"
			rewards: [{
				id: "4000000000000F05"
				type: "xp"
				xp: 150
			}]
			shape: "square"
			subtitle: "The Break Glyph"
			tasks: [{
