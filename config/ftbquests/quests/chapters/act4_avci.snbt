	quests: [
		{
			dependencies: ["2000000000000B41"]
			description: [
				"Yeraltındaki odada bin yıldır bekleyen bir zırh var."
				"Zırhın içindeki şey uyanırsa, tek bir vuruşu yeter."
				""
				"§7A suit of armour has waited a thousand years in the chamber below."
				"§7If what sleeps inside it wakes, a single blow is enough.§r"
			]
			icon: "mowziesmobs:wrought_helmet"
			id: "2000000000000A41"
			rewards: [{
				id: "4000000000000A41"
				type: "xp_levels"
				xp_levels: 20
			}]
			shape: "hexagon"
			size: 1.5d
			subtitle: "The Wrought Helm"
			tasks: [{
				id: "3000000000000A41"
				item: "mowziesmobs:wrought_helmet"
				type: "item"
			}]
			title: "Dövülmüş Miğfer"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: [
				"2000000000000A41"
				"2000000000000C21"
				"2000000000000B42"
			]
			description: [
				"Nehir senin için çalışabilir. Yorulmaz, uyumaz, ücret istemez."
				""
				"§eGerekli:§r 3 Kadim Öfke ve 32 andezit alaşımı. Öfke Kadim"
				"Dikilitaş ödül sandığından gelir - dalgaları temizlemeden"
				"açılmaz. Alaşım ise 64 demir külçe demek."
				""
				"§cStrateji:§r Dikilitaşa tek başına gitme. Dalgalar arasında"
				"nefes alacak vaktin yok ve canların sayılı. Bu perdeye kadar"
				"topladığın oku ve arbaleti getir."
				""
				"§8Ödül: Mühendislik 20 - su çarkı, pres, huni, muhafaza§r"
				""
				"§7The river can work for you. It does not tire, sleep, or ask for pay."
				""
				"§7Requires 3 Ancient Wrath and 32 andesite alloy. Wrath comes from the"
				"§7obelisk reward chest, which does not open until the waves are cleared;"
				"§7the alloy is 64 iron ingots. Do not go to an obelisk alone - there is"
				"§7no breathing room between waves and your lives are counted."
				""
				"§8Reward: Engineering 20 - water wheel, press, funnels, casings§r"
			]
			icon: "create:water_wheel"
			id: "2000000000000A42"
			rewards: [{
				command: "/pmmo admin @p set engineering level 20"
				elevate_perms: true
				id: "4000000000000A42"
				silent: true
				title: "Mühendislik 20 / Engineering 20"
				type: "command"
			}]
			shape: "gear"
			size: 2.0d
			subtitle: "The Power of Water"
			tasks: [{
				count: 32L
				id: "3000000000000A42"
				item: "create:andesite_alloy"
				type: "item"
			}]
			title: "Suyun Gücü"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["2000000000000A33"]
			description: [
				"Dövülmüş Şövalye demirden zırhı kâğıt gibi keser."
				"Tek vuruşu hazırlıksız bir adamı öldürür - ve senin canların sayılı."
				"Kılıç yetmez. Zırh da giy."
				""
				"§7The Wroughtnaut cuts iron like paper."
				"§7A single blow kills an unprepared man, and your lives are counted."
				"§7A sword is not enough. Wear the armour too.§r"
			]
			icon: {
				Count: 1
				id: "minecraft:diamond_sword"
				tag: {
					Damage: 0
				}
			}
