	quests: [
		{
			description: [
				"Bir makineyi kuramazsan, tamir de edemezsin."
				""
				"§bNeden:§r Gözlük bir makineye baktığında hız, gerilim ve akışkan"
				"seviyesini gösterir. İngiliz anahtarı blokları döndürür ve söker -"
				"onsuz yanlış yerleştirdiğin her makineyi kırıp yeniden yaparsın."
				""
				"§eTarif:§r Gözlük = altın külçe + cam. Anahtar = altın + andezit alaşımı."
				""
				"§7You cannot repair what you cannot read. Goggles show speed, stress and"
				"§7fluid levels. The wrench rotates and dismantles - without it every"
				"§7misplaced machine gets broken and rebuilt.§r"
			]
			icon: "create:goggles"
			id: "2000000000000B31"
			optional: true
			rewards: [{
				id: "4000000000000E31"
				type: "xp"
				xp: 120
			}]
			shape: "square"
			subtitle: "The Engineer's Tools"
			tasks: [
				{
					id: "3000000000000B31"
					item: "create:goggles"
					type: "item"
				}
				{
					id: "3000000000000B37"
					item: "create:wrench"
					type: "item"
				}
			]
			title: "Mühendisin Aletleri"
			x: 3.0d
			y: -5.25d
		}
		{
			dependencies: ["2000000000000B31"]
			description: [
				"Zindanların dibinde paslanmış bir dişli."
				""
				"§bNeden:§r Create artık seviyeye değil, keşfe bağlı. Bu dişli"
				"temel makineleri açar - zindan sandıklarında bulunur."
				""
				"§eNerede:§r Dungeons Arise ve Dungeon Crawl sandıkları, kaleler."
				""
				"§7Create is gated by exploration now, not levels. Found in dungeon"
				"§7chests - Dungeons Arise, Dungeon Crawl, strongholds.§r"
			]
			icon: "kubejs:rusted_gear"
			id: "20000000000E0101"
			rewards: [{
