		{
			dependencies: ["20000000000E0102"]
			description: [
				"Hâlâ dönen, kimsenin yapamadığı bir çekirdek."
				""
				"§bNeden:§r Buhar motoru ve yerleştirici - Create'in tepe noktası."
				""
				"§eNerede:§r En derin zindan sandıkları. Nadirdir; grup hâlinde"
				"zindan temizlemek en hızlı yol."
				""
				"§7Steam engine and deployer - the top of Create."
				"§7Deepest dungeon chests, and rare. Clearing dungeons as a group"
				"§7is the fastest route.§r"
			]
			icon: "kubejs:precision_core"
			id: "20000000000E0103"
			rewards: [{
				id: "40000000000E0103"
				type: "xp"
				xp: 250
