		}
		{
			dependencies: ["20000000000E0101"]
			description: [
				"Yarısı yanmış bir mühendis şeması."
				""
				"§bNeden:§r Pirinç çağını açar - karıştırıcı, fan, pirinç döküm."
				""
				"§eNerede:§r Daha derin zindanlarda, paslı dişliden nadir."
				""
				"§7Opens the brass age: mixer, fan, brass casting."
				"§7Deeper dungeons; rarer than the rusted gear.§r"
			]
			icon: "kubejs:brass_schematic"
			id: "20000000000E0102"
