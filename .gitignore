# --- Secrets ---------------------------------------------------------------
# SimpleLogin stored its password in PLAINTEXT here. The mod is gone, but the
# file may still exist on older installs, so keep ignoring it.
.sl_password

# SimpleAuth keeps per-player PBKDF2 password hashes here, and unlike
# .sl_password this sits INSIDE the tracked config/ tree - one `git add -A`
# would publish every player's credential hash to a public repo.
config/simpleauth/simpleauth_users.json

# --- Binaries --------------------------------------------------------------
# Mods and resource packs are distributed through the launcher manifest,
# not through git. ~650 MB of jars does not belong in a repository.
mods/
removed-mods/
resourcepacks/
KC5 1.9/

# --- World and player state ------------------------------------------------
saves/
logs/
crash-reports/
journeymap/
local/
modernfix/
blueprints/
config/spark/tmp/
config/jei/world/

# --- Caches and per-install files ------------------------------------------
data/serilum/
patchouli_data.json
rhino.local.properties
options.txt
servers.dat
servers.dat_old
usercache.json
usernamecache.json
.qmenu_opened.marker
config/skinrestorer/mojang_profile_cache.json
config/voicechat/username-cache.json

# Built distribution bundles (uploaded to R2, not versioned here)
knightcraft5-*.zip

# R2 credentials - never commit
r2.env
.env

# CI build output
dist/

# Python bytecode from tools/
__pycache__/
*.pyc
